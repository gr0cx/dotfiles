#! /bin/sh

pgrep -x sxhkd >/dev/null || sxhkd &
python3 ~/.config/eww/scripts/notif_daemon.py &
~/.config/eww/scripts/battery_notifier.sh &
eww open principal-bar &
feh --bg-fill $HOME/Pictures/Wallpapers/wallpaper.jpg &

bspc config focus_follows_mouse off
bspc config pointer_modifier mod1

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width 2
bspc config focused_border_color "#00ff66"
bspc config normal_border_color "#1a2026"
bspc config active_border_color "#00b347"
bspc config window_gap 12

bspc config top_padding 48
bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a Eww manage=off
bspc rule -a *:FloatingTerm state=floating center=on rectangle=750x450+0+0

picom --config $HOME/.config/picom/picom.conf &
amixer set Speaker $(amixer get Master | grep "Mono:" | cut -d'[' -f2 | cut -d']' -f1)
